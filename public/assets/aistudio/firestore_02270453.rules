rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /sharedBooks/{bookId} {
      // Anyone with a share URL can read a book; only its anonymous owner can modify it.
      allow read: if true;
      allow create: if request.auth != null
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.pageUrls is list
        && request.resource.data.pageUrls.size() > 0
        && request.resource.data.pageUrls.size() <= 500;
      allow update, delete: if request.auth != null
        && resource.data.ownerUid == request.auth.uid;
    }
  }
}
